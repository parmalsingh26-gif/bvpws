# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# JWT_SECRET: Secret key for signing admin JWT tokens.
# MUST be a strong random string in production (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# NODE_ENV: Set to 'production' for live deployment
NODE_ENV=development

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/bvpws
